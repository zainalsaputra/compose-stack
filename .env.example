COMPOSE_PROJECT_NAME=jenkins-stack

# Jenkins
JENKINS_IMAGE=myjenkins-blueocean:lts
JENKINS_HTTP_PORT=49000
JENKINS_AGENT_PORT=50000
JENKINS_JAVA_OPTS=-Dhudson.plugins.git.GitSCM.ALLOW_LOCAL_CHECKOUT=true
NGINX_HTTP_PORT=9000

# Shared folder mounted to /home inside Jenkins.
# On Ubuntu, create this folder first if it does not exist:
# sudo mkdir -p /srv/jenkins/home && sudo chown -R 1000:1000 /srv/jenkins/home
HOST_HOME=/srv/jenkins/home

# Docker-in-Docker
DOCKER_DIND_PORT=2376
DIND_APP_PORT=3000

# Observability profile
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
