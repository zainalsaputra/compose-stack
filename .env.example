COMPOSE_PROJECT_NAME=compose-stack

# Docker network names.
CI_NETWORK_NAME=compose-stack-ci
OBSERVABILITY_NETWORK_NAME=compose-stack-observability
APP_INGRESS_NETWORK_NAME=compose-stack-app-ingress

# Jenkins image and shared host directory.
JENKINS_IMAGE=myjenkins-blueocean:lts
JENKINS_JAVA_OPTS=-Dhudson.plugins.git.GitSCM.ALLOW_LOCAL_CHECKOUT=true
HOST_HOME=/srv/jenkins/home

# Same-host Jenkins deployment support. setup-cloudflare.sh refreshes both values
# automatically from the current server before applying the stack.
HOST_DOCKER_GID=999
COMPOSE_STACK_HOST_PATH=/opt/compose-stack

# Local / IP:port mode. These values are used by compose.local.yaml.
JENKINS_HTTP_PORT=49000
JENKINS_AGENT_PORT=50000
NGINX_HTTP_PORT=9000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3030

# Service hostnames. Reused by both direct HTTPS and Cloudflare Tunnel modes.
JENKINS_DOMAIN=jenkins.ops.example.com
GRAFANA_DOMAIN=grafana.ops.example.com

# Wildcard application ingress used with Cloudflare Tunnel.
# Configure one Cloudflare Published Application route:
#   *.apps.example.com -> http://nginx:80
# Deployed application hostnames should be children of this suffix.
APP_DOMAIN_SUFFIX=apps.example.com

# Direct DNS + HTTPS ingress mode. Configure public DNS before running
# setup.sh --with-https.
ACME_EMAIL=devops@example.com
HTTP_PORT=80
HTTPS_PORT=443
LETSENCRYPT_DIR=/etc/letsencrypt

# Cloudflare Tunnel mode. Keep the real token only in .env (which is ignored by Git).
# Create a remotely-managed tunnel in Cloudflare Zero Trust and copy its token here.
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
CLOUDFLARE_TUNNEL_PROTOCOL=http2

# Docker named volumes.
JENKINS_DATA_VOLUME=compose-stack-jenkins-data
JENKINS_DOCKER_CERTS_VOLUME=compose-stack-jenkins-docker-certs
PROMETHEUS_DATA_VOLUME=compose-stack-prometheus-data
GRAFANA_DATA_VOLUME=compose-stack-grafana-data

# Grafana.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
