COMPOSE_PROJECT_NAME=compose-stack

# Docker network names.
# In the non-separated setup, networks are defined in compose.yaml because all
# services are deployed as one stack from this root folder.
CI_NETWORK_NAME=compose-stack-ci
OBSERVABILITY_NETWORK_NAME=compose-stack-observability

# Jenkins
JENKINS_IMAGE=myjenkins-blueocean:lts
JENKINS_HTTP_PORT=49000
JENKINS_AGENT_PORT=50000
JENKINS_JAVA_OPTS=-Dhudson.plugins.git.GitSCM.ALLOW_LOCAL_CHECKOUT=true
NGINX_HTTP_PORT=9000

# Shared folder mounted to /home inside Jenkins.
# On Ubuntu, create this folder first if it does not exist:
# sudo mkdir -p /srv/jenkins/home && sudo chown -R 1000:1000 /srv/jenkins/home
HOST_HOME=/srv/jenkins/home

# Docker named volumes.
# These are stored by Docker under /var/lib/docker/volumes on Ubuntu, not inside
# this Git repository.
JENKINS_DATA_VOLUME=compose-stack-jenkins-data
JENKINS_DOCKER_CERTS_VOLUME=compose-stack-jenkins-docker-certs
PROMETHEUS_DATA_VOLUME=compose-stack-prometheus-data
GRAFANA_DATA_VOLUME=compose-stack-grafana-data

# Docker-in-Docker
DOCKER_DIND_PORT=2376
DIND_APP_PORT=3000

# Observability profile
PROMETHEUS_PORT=9090
GRAFANA_PORT=3030
GRAFANA_INTERNAL_PORT=3030
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
